# Environment Configuration Template
# Copy to .env and fill in your values

# Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=pharma_pipeline
POSTGRES_USER=pharma_user
POSTGRES_PASSWORD=your_password_here

MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_DB=pharma_pipeline
MONGODB_USER=pharma_user
MONGODB_PASSWORD=your_password_here

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key

# AgentCore Configuration
AGENTCORE_ENDPOINT=https://your-agentcore-endpoint
AGENTCORE_API_KEY=your_api_key

# Observability Configuration
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key
LANGFUSE_SECRET_KEY=your_langfuse_secret_key
LANGFUSE_HOST=https://cloud.langfuse.com

OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=agentic-pharma-pipeline

# Web Scraping Configuration
USER_AGENT=AgenticPharmaPipeline/1.0 (+https://example.com/contact)
REQUEST_DELAY_MIN=1.0
REQUEST_DELAY_MAX=3.0
MAX_RETRIES=3
TIMEOUT_SECONDS=30

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json

# Development Configuration
ENVIRONMENT=development
DEBUG=true